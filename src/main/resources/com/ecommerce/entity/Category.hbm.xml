<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-access="field">
    <class name="com.ecommerce.entity.Category" table="category">
        <id name="id" type="int" column="category_id">
            <generator class="native" />
        </id>
        <property name="name" type="string" column="category_name" />
        <property name="totalCategoryProduct" type="int" column="category_number_product" />
    </class>
</hibernate-mapping>
