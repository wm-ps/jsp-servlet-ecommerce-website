<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-access="field">
    <class name="com.ecommerce.entity.Product" table="product">
        <id name="id" type="int" column="product_id">
            <generator class="native" />
        </id>
        <property name="name" type="string" column="product_name" />
        <property name="image" type="binary" column="product_image" length="2147483647" />
        <property name="price" type="double" column="product_price" />
        <property name="description" type="string" column="product_description" length="3000" />
        <many-to-one name="category" class="com.ecommerce.entity.Category"
                     column="fk_category_id" fetch="join" lazy="false" />
        <many-to-one name="account" class="com.ecommerce.entity.Account"
                     column="fk_account_id" fetch="join" lazy="false" />
        <property name="isDeleted" type="boolean" column="product_is_deleted" />
        <property name="amount" type="int" column="product_amount" />
    </class>
</hibernate-mapping>
